extends layout

block content
  div
    .row.mb-2
      .col
        h4=title
          span.float-end
            a(href='/control/ctrlr/') New Controller
        hr
    .row.row-cols-1.row-cols-md-2
      if controllers.length > 0
        each controller in controllers
          .col
            .card.mb-4
              .card-header
                b=controller.name
                span.float-end
                    a(href='/control/ctrlr/' + controller._id) Edit Controller
              .card-body
                p
                  b.control-label Enabled:&nbsp
                  | #{controller.enabled}
                p
                  b Model:&nbsp
                  | #{controller.model}
                p
                  b Update Rate:&nbsp
                  | #{controller.updateRate}
                hr
                p
                  if controller.sensor
                    b Sensor:&nbsp
                    | #{controller.sensor.name} (#{controller.sensor.model} @ #{controller.sensor.id})
                p
                  if controller.output
                    b Output:&nbsp
                    | #{controller.output.name} (#{controller.output.model} @ #{controller.output.id})
              if controller.param && Object.keys(controller.param).length > 0
                .card-header Parameters:
                // If steps present, show schedule
                if controller.param.steps && controller.param.steps.length > 0
                  table.table.table-bordered
                    tr
                      th Step
                      th Temperature
                      th Duration
                    each step, idx in controller.param.steps
                      tr
                        td #{idx + 1}
                        td #{step.temperature}°C
                        - var d = step.duration || 0
                        - var days = Math.floor(d / 86400000)
                        - var hours = Math.floor((d % 86400000) / 3600000)
                        td #{days}d #{hours}h
                else
                  table.table.table-bordered
                    tr
                      th Name
                      th Value
                    each item, name in controller.param
                      tr
                        td #{name}
                        td #{item}

